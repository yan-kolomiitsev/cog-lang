// Binary search and bound operations for arrays sorted by Ord.
use ord::Ord;

public fn binary[T: type + Ord](items: T[], target: T) -> int {
    var low = 0;
    var high = items.len();

    while low < high {
        const mid = low + (high - low) / 2;
        const cmp = items[mid].compare(target);

        if cmp < 0 {
            low = mid + 1;
        } else if cmp > 0 {
            high = mid;
        } else {
            return mid;
        }
    }

    -1
}

public fn lower_bound[T: type + Ord](items: T[], target: T) -> int {
    var low = 0;
    var high = items.len();

    while low < high {
        const mid = low + (high - low) / 2;
        const cmp = items[mid].compare(target);

        if cmp < 0 {
            low = mid + 1;
        } else {
            high = mid;
        }
    }

    low
}

public fn upper_bound[T: type + Ord](items: T[], target: T) -> int {
    var low = 0;
    var high = items.len();

    while low < high {
        const mid = low + (high - low) / 2;
        const cmp = items[mid].compare(target);

        if cmp <= 0 {
            low = mid + 1;
        } else {
            high = mid;
        }
    }

    low
}
