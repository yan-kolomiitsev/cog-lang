include std;
use io;

comptime fn with_default(value: int?) -> int {
    value ?? 5
}

comptime fn recover_division(value: int) -> int {
    value ?! 9
}

comptime fn fail() -> int {
    (1 / 0)!!
}

comptime fn recover_propagated_error() -> int {
    try {
        fail();
    } catch (error) {
        return 13;
    }
    0
}

comptime EMPTY = with_default(nil);
comptime PRESENT = with_default(4);
comptime RECOVERED = recover_division(1 / 0);
comptime PROPAGATED = recover_propagated_error();

fn main() -> nil {
    io::println(EMPTY)!!;
    io::println(PRESENT)!!;
    io::println(RECOVERED)!!;
    io::println(PROPAGATED)!!;
}
